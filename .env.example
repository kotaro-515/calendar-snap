# Calendar Snap - 環境変数設定テンプレート
# このファイルを「.env」にコピーし、実際の値を入力してください。

# サーバー起動ポート
PORT=3000

# Google Cloud Consoleで作成した OAuth 2.0 クライアント情報
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Google AI Studioで取得した Gemini APIキー
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# セッション暗号化キー (推測しにくい適当な長い文字列を入力してください)
SESSION_SECRET=super_secret_calendar_snap_session_key_2026
